<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <j:choose>
    <j:when test="${it.urlName != null}">
      <a href="${it.urlName}" target="_blank" rel="noopener noreferrer" tooltip="${it.tooltip}" style="color: var(--text-color-secondary)">
        <l:icon src="symbol-sonarqube plugin-sonar" class="icon-sm" alt="[sonarqube]"/>
      </a>
    </j:when>
    <j:otherwise>
      <l:icon src="symbol-sonarqube plugin-sonar" class="icon-sm" tooltip="${it.tooltip}" alt="[sonarqube]"/>
    </j:otherwise>
  </j:choose>
</j:jelly>
